# App
NODE_ENV=development
APP_ROLE=api
APP_PORT=3001
CORS_ORIGIN=http://localhost:3000

# Database
# Host-side port is 5433 (mapped from the container's 5432) to avoid clashing
# with a native PostgreSQL install on the default port. Inside Docker Compose,
# backend-api talks to the container directly via postgres:5432.
DATABASE_URL=postgresql://apimonitor:apimonitor@localhost:5433/apimonitor
DATABASE_POOL_SIZE=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Mail
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=noreply@apimonitor.local

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1
