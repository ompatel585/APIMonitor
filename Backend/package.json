{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "nest build",
    "start:dev": "cross-env APP_ROLE=api nest start --watch",
    "start:worker": "cross-env APP_ROLE=worker nest start --watch -e src/worker.ts",
    "start:scheduler": "cross-env APP_ROLE=scheduler nest start --watch -e src/scheduler.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:integration": "jest --config test/integration/jest-integration.json",
    "test:e2e": "jest --config test/e2e/jest-e2e.json"
  },
  "dependencies": {
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/swagger": "8.1.1",
    "@nestjs/typeorm": "10.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "nestjs-pino": "4.3.1",
    "pino-http": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "pg": "8.13.1"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.15",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "@typescript-eslint/eslint-plugin": "8.19.0",
    "@typescript-eslint/parser": "8.19.0",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-boundaries": "5.0.1",
    "jest": "29.7.0",
    "prettier": "3.4.2",
    "source-map-support": "0.5.21",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2"
  }
}
