{
  "name": "backend",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "build": "nest build",
    "start:dev": "cross-env APP_ROLE=api nest start --watch",
    "start:worker": "cross-env APP_ROLE=worker nest start --watch --entryFile worker",
    "start:scheduler": "cross-env APP_ROLE=scheduler nest start --watch --entryFile scheduler",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "test": "jest",
    "test:integration": "jest --config test/integration/jest-integration.json",
    "test:e2e": "jest --config test/e2e/jest-e2e.json",
    "migration:generate": "cross-env TS_NODE_PROJECT=tsconfig.json ts-node -r tsconfig-paths/register -r dotenv/config ../node_modules/typeorm/cli.js migration:generate -d src/infrastructure/database/data-source.ts",
    "migration:run": "cross-env TS_NODE_PROJECT=tsconfig.json ts-node -r tsconfig-paths/register -r dotenv/config ../node_modules/typeorm/cli.js migration:run -d src/infrastructure/database/data-source.ts"
  },
  "dependencies": {
    "@nestjs/bullmq": "10.2.3",
    "@nestjs/common": "10.4.15",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.4.15",
    "@nestjs/event-emitter": "2.1.1",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/passport": "10.0.3",
    "@nestjs/platform-express": "10.4.15",
    "@nestjs/schedule": "4.1.2",
    "@nestjs/swagger": "8.1.1",
    "@nestjs/terminus": "10.2.3",
    "@nestjs/throttler": "6.3.0",
    "@nestjs/typeorm": "10.0.2",
    "argon2": "0.41.1",
    "bullmq": "5.34.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.4.7",
    "ioredis": "5.4.2",
    "nestjs-pino": "4.3.1",
    "nodemailer": "6.9.16",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pino-http": "10.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "typeorm": "0.3.20",
    "pg": "8.13.1",
    "undici": "7.2.0"
  },
  "devDependencies": {
    "@nestjs/cli": "10.4.9",
    "@nestjs/testing": "10.4.15",
    "@types/cookie-parser": "1.4.8",
    "@types/express": "5.0.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.5",
    "@types/nodemailer": "6.4.17",
    "@types/passport-jwt": "4.0.1",
    "@typescript-eslint/eslint-plugin": "8.19.0",
    "@typescript-eslint/parser": "8.19.0",
    "cross-env": "7.0.3",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-boundaries": "5.0.1",
    "jest": "29.7.0",
    "pino-pretty": "13.0.0",
    "prettier": "3.4.2",
    "source-map-support": "0.5.21",
    "ts-jest": "29.2.5",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.7.2"
  }
}
